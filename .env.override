# DO NOT PUSH CHANGES OF THIS FILE TO opentelemetry/opentelemetry-demo
# PLACE YOUR .env ENVIRONMENT VARIABLES OVERRIDES IN THIS FILE
_JAVA_OPTIONS=-XX:UseSVE=0
CURRENCY_PORT=7001
AD_ADDR=127.0.0.1:${AD_PORT}
CART_ADDR=127.0.0.1:${CART_PORT}
CHECKOUT_ADDR=127.0.0.1:${CHECKOUT_PORT}
CURRENCY_ADDR=127.0.0.1:${CURRENCY_PORT}
EMAIL_ADDR=http://127.0.0.1:${EMAIL_PORT}
PAYMENT_ADDR=127.0.0.1:${PAYMENT_PORT}
PRODUCT_CATALOG_ADDR=127.0.0.1:${PRODUCT_CATALOG_PORT}
QUOTE_ADDR=http://127.0.0.1:${QUOTE_PORT}
RECOMMENDATION_ADDR=127.0.0.1:${RECOMMENDATION_PORT}
SHIPPING_ADDR=127.0.0.1:${SHIPPING_PORT}
FRONTEND_HOST=otel
FRONTEND_ADDR=otel:${FRONTEND_PORT}